diff --git a/src/users/find.ts b/src/users/find.ts
--- a/src/users/find.ts
+++ b/src/users/find.ts
@@ -1,3 +1,13 @@
 import { db } from "../db";
 
+/**
+ * Looks up a user by email. Never throws: returns `null` when no user has
+ * that email, so callers can show a "sign up instead?" prompt.
+ */
+export async function findUserByEmail(email: string): Promise<User | null> {
+  const user = await db.user.findUnique({ where: { email } });
+  if (!user) throw new NotFoundError(`No user with email ${email}`);
+  return user;
+}
+
